  "components": {
    "schemas": {
      "Body_index_document_internal_v1_documents_index_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "metadata": {
            "type": "string",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "file",
          "metadata"
        ],
        "title": "Body_index_document_internal_v1_documents_index_post"
      },
      "DocumentVersion": {
        "properties": {
          "document_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Document Id"
          },
          "index_version": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Index Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "index_version"
        ],
        "title": "DocumentVersion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 16000,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "HistoryMessage"
      },
      "QueryRequest": {
        "properties": {
          "knowledge_base_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Knowledge Base Id"
          },
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 40,
            "title": "History"
          },
          "allowed_documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentVersion"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Allowed Documents"
          },
          "retrieval": {
            "$ref": "#/components/schemas/RetrievalOptions"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "knowledge_base_id",
          "query",
          "allowed_documents"
        ],
        "title": "QueryRequest"
      },
      "RetrievalOptions": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "dense",
              "sparse",
              "hybrid"
            ],
            "title": "Mode",
            "default": "hybrid"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "candidate_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Candidate K",
            "default": 20
          },
          "use_rerank": {
            "type": "boolean",
            "title": "Use Rerank",
            "default": true
          },
          "use_hyde": {
            "type": "boolean",
            "title": "Use Hyde",
            "default": false
          },
          "use_web": {
            "type": "boolean",
            "title": "Use Web",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RetrievalOptions"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
