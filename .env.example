# 复制为 .env；scripts/start-local.ps1 会生成并保存内部服务密钥。
# 旧配置 OPEN_API_KEY/OPEN_API_BASE/LLM_DEFAULT_MODEL/MILVUS_URL 仍兼容。
RAG_SERVICE_KEY=replace-with-a-random-service-key
RAG_ENGINE_URL=http://127.0.0.1:8000

# 兼容 Chat Completions 的生成服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# 真 BGE-M3：1024 维 xlm-roberta，具有 sparse_linear.pt，不能使用 BGE-base 代替。
BGE_M3_PATH=D:/models/bge-m3
BGE_RERANKER_LARGE=D:/models/bge-reranker-large
BGE_DEVICE=cpu
BGE_FP16=false
RAG_DOMAIN_MODE=general
RAG_MAX_CONCURRENCY=2
RAG_TIMEOUT_SECONDS=120
RAG_INDEX_TIMEOUT_SECONDS=600
RAG_CHUNK_CHARS=1800
RAG_CONTEXT_CHARS=14000
RAG_MAX_UPLOAD_BYTES=20971520

# 独立 v2 集合，不覆写旧知识库。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
RAG_COLLECTION=knowledge_chunks_v2

# Java 默认 H2 文件库；MySQL 配置见 README。
JAVA_PORT=8080
TOKEN_HOURS=24
INGEST_WORKERS=2
INGEST_QUEUE_CAPACITY=8
STREAM_WORKERS=4
STREAM_QUEUE_CAPACITY=16
RAG_CONNECT_TIMEOUT_SECONDS=5
RAG_REQUEST_TIMEOUT_SECONDS=120
RAG_INGEST_TIMEOUT_SECONDS=600
RAG_STREAM_TIMEOUT_SECONDS=180

# PDF 才需要 MinerU；普通 Markdown 无需配置。
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
# 结果 CDN 在部分代理网络下无法完成 TLS 连接；此域名使用直连，其他请求仍遵循代理设置。
NO_PROXY=localhost,127.0.0.1,::1,cdn-mineru.openxlab.org.cn

# 可选图片摘要和对象存储。
RAG_ENABLE_VLM=false
VL_MODEL=qwen3-vl-flash
RAG_ENABLE_MINIO=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-engine
MINIO_SECURE=false

# 请求 use_web 也需开启此能力才会调用。
RAG_ENABLE_WEB=false
RAG_WEB_TIMEOUT_SECONDS=8
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_DASHSCOPE_API_KEY=
